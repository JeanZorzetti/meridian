---
import NetWorthChart, { MONTHS } from "../react/NetWorthChart.tsx";
import CountUp from "../react/CountUp.tsx";
---

<section class="hero relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28" data-spotlight>
  <!-- layered ambient field: Swiss grid (parallax) · drifting mint aurora ·
       cursor spotlight. Stacked back-to-front, all decorative. -->
  <div
    class="hero-bg pointer-events-none absolute inset-x-0 top-[-10%] h-[120%]"
    aria-hidden="true"
    data-parallax="0.12"
  >
  </div>
  <div class="hero-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="hero-spot pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="wrap relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
      <!-- left: thesis -->
      <div>
        <p class="eyebrow mb-5 flex items-center gap-2">
          <span class="bg-profit inline-block h-1.5 w-1.5 rounded-full"></span>
          Personal finance, precision-built
        </p>
        <h1
          class="text-[2.75rem] leading-[1.02] font-semibold tracking-[-0.045em] text-balance sm:text-6xl lg:text-[4.25rem]"
        >
          See every dollar.<br />
          <span class="text-muted-foreground">Own every decision.</span>
        </h1>
        <p class="text-muted-foreground mt-6 max-w-md text-base leading-relaxed sm:text-lg">
          Meridian tracks your net worth, spending, and investments in one
          calm, fast interface — the clarity of a professional trading desk,
          built for your money.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="#cta"
            class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-11 items-center rounded-md px-5 text-sm font-medium transition-colors"
          >
            Start tracking free
          </a>
          <a
            href="#tour"
            class="border-border text-foreground hover:bg-accent inline-flex h-11 items-center gap-2 rounded-md border px-5 text-sm font-medium transition-colors"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M4 3l7 4-7 4V3z" fill="currentColor" />
            </svg>
            See a live demo
          </a>
        </div>

        <p class="text-muted-foreground mt-6 font-mono text-xs tracking-wide">
          No card required · Bank-grade encryption · 12,000+ portfolios tracked
        </p>
      </div>

      <!-- right: product preview — floats on a soft mint bloom, tilts to the
           cursor, catches a sheen. The one card where boldness is spent. -->
      <div class="relative [perspective:1400px]">
        <div
          class="pointer-events-none absolute -inset-6 -z-10 rounded-[2rem] opacity-70 blur-2xl"
          style="background: radial-gradient(60% 60% at 50% 25%, rgba(62,207,142,0.12), transparent 70%)"
          aria-hidden="true"
        >
        </div>
        <div class="glass tilt glow-mint relative rounded-xl p-5 sm:p-6" data-tilt="6">
          <span class="glare" aria-hidden="true"></span>
          <div class="flex items-start justify-between">
          <div>
            <p class="eyebrow">Net worth</p>
            <p class="text-muted-foreground mt-1 text-xs">All accounts</p>
          </div>
          <div class="border-border flex items-center gap-0.5 rounded-md border p-0.5">
            {
              ["1M", "1Y", "ALL"].map((p) => (
                <span
                  class={`rounded px-2 py-1 font-mono text-[11px] ${p === "ALL" ? "bg-accent text-foreground" : "text-muted-foreground"}`}
                >
                  {p}
                </span>
              ))
            }
          </div>
        </div>

        <div class="mt-4 flex items-end gap-3" style="transform: translateZ(45px)">
          <span class="tnum text-4xl font-semibold tracking-[-0.02em] sm:text-5xl">
            <CountUp to={128540} prefix="$" duration={1600} client:load />
          </span>
          <span
            class="text-profit mb-2 inline-flex items-center gap-1 rounded bg-[#3ecf8e]/10 px-1.5 py-0.5 font-mono text-xs"
          >
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M5 2l3 4H2l3-4z" fill="currentColor"></path>
            </svg>
            4.2%
          </span>
        </div>

        <div class="mt-3 h-44 w-full sm:h-48">
          <NetWorthChart client:load />
        </div>
        <div class="text-muted-foreground flex justify-between px-1 font-mono text-[10px]">
          {MONTHS.map((m) => <span>{m}</span>)}
        </div>

        <div class="border-border mt-5 grid grid-cols-3 gap-4 border-t pt-5">
          <div>
            <p class="eyebrow">Spending</p>
            <p class="tnum mt-1.5 text-sm">$4,200</p>
          </div>
          <div>
            <p class="eyebrow">Saved</p>
            <p class="tnum text-profit mt-1.5 text-sm">$1,850</p>
          </div>
          <div>
            <p class="eyebrow">Invested</p>
            <p class="tnum mt-1.5 text-sm">$12,400</p>
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background-image:
      radial-gradient(620px 420px at 88% 8%, rgba(62, 207, 142, 0.07), transparent 70%),
      linear-gradient(to right, var(--hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hairline) 1px, transparent 1px);
    background-size:
      100% 100%,
      104px 104px,
      104px 104px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 40%, transparent 82%);
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 40%, transparent 82%);
    /* --py written by the parallax handler; drifts the grid on scroll */
    transform: translate3d(0, var(--py, 0), 0);
    will-change: transform;
  }

  /* second depth layer: two mint blooms that slowly breathe across the top */
  .hero-aurora {
    background:
      radial-gradient(520px 320px at 22% 26%, rgba(62, 207, 142, 0.07), transparent 70%),
      radial-gradient(440px 280px at 78% 16%, rgba(62, 207, 142, 0.05), transparent 72%);
    -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 28%, transparent 82%);
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 28%, transparent 82%);
    animation: hero-drift 20s var(--ease-swiss) infinite alternate;
    will-change: transform;
  }
  @keyframes hero-drift {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }
    to {
      transform: translate3d(3%, 2%, 0) scale(1.09);
    }
  }

  /* top layer: mint spotlight tracking the cursor (--mx/--my from data-spotlight) */
  .hero-spot {
    background: radial-gradient(
      380px circle at var(--mx, 50%) var(--my, 30%),
      rgba(62, 207, 142, 0.09),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease-swiss);
  }
  .hero:hover .hero-spot {
    opacity: 1;
  }
</style>
