---
import CountUp from "../react/CountUp.tsx";

const stats = [
  { to: 4.2, prefix: "$", suffix: "B", decimals: 1, label: "Net worth tracked" },
  { to: 12400, suffix: "+", decimals: 0, label: "Portfolios connected" },
  { to: 99.98, suffix: "%", decimals: 2, label: "Uptime, trailing 12 mo" },
  { to: 4.9, suffix: "/5", decimals: 1, label: "Average app rating" },
];
---

<section class="border-border relative overflow-hidden border-y" data-spotlight>
  <div class="metric-spot pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="wrap relative grid grid-cols-2 md:grid-cols-4">
    {
      stats.map((s, i) => (
        <div
          class:list={[
            "border-border group py-8 transition-colors duration-300 hover:bg-white/[0.02] md:py-10",
            i % 2 === 1 && "border-l",
            i >= 2 && "border-t md:border-t-0",
            i > 0 && "md:border-l",
            i % 2 === 0 && "pr-4 md:pl-6 lg:pl-8",
            i % 2 === 1 && "pl-4 md:pl-6 lg:pl-8",
          ]}
        >
          <div class="tnum text-3xl font-semibold tracking-[-0.02em] transition-transform duration-300 group-hover:-translate-y-0.5 md:text-4xl">
            <CountUp
              to={s.to}
              prefix={s.prefix}
              suffix={s.suffix}
              decimals={s.decimals}
              client:visible
            />
          </div>
          <p class="text-muted-foreground mt-2 text-sm">{s.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .metric-spot {
    background: radial-gradient(
      320px circle at var(--mx, 50%) var(--my, 50%),
      hsl(0 0% 100% / 0.05),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease-swiss);
  }
  section:hover .metric-spot {
    opacity: 1;
  }
</style>
