{
  "name": "meridian",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @meridian/site",
    "build": "npm run build -w @meridian/site",
    "start": "npm run start -w @meridian/site",
    "preview": "npm run preview -w @meridian/site",
    "dev:app": "npm run dev -w @meridian/app",
    "build:app": "npm run build -w @meridian/app",
    "start:app": "npm run start -w @meridian/app",
    "build:all": "npm run build && npm run build:app",
    "db:migrate": "node --env-file=.env packages/db/migrate.mjs",
    "db:seed": "node --env-file=.env packages/db/seed-admin.mjs",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:import-xlsx": "node --experimental-strip-types --env-file=.env packages/db/seed-xlsx.mjs",
    "test": "npm run test -w @meridian/core && npm run test -w @meridian/db",
    "db:test": "npm test"
  },
  "devDependencies": {
    "shadcn": "^4.13.0"
  }
}
