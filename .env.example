# Postgres connection string. sslmode=disable for a plain (non-TLS) host.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# Seeded admin login (created on first `npm run db:init`).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional. Last resort for categorizing a description the rules and the learned
# model can't place (src/lib/classify-llm.ts). Unset = that step is skipped.
ANTHROPIC_API_KEY=

# Emergency brake, for the deployed environment only — leave this unset.
# `npm start` migrates before booting the server, so a migration that cannot run
# keeps the container down. Setting MIGRATE_SKIP=1 in EasyPanel skips that step
# and gets the site back up while the migration is fixed. A server running on an
# un-migrated schema is the failure this whole system exists to prevent, so
# unset it again as soon as the migration is fixed.
# MIGRATE_SKIP=
