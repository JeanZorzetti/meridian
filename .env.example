# Postgres connection string. sslmode=disable for a plain (non-TLS) host.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# Seeded admin login (created on first `npm run db:init`).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional. Last resort for categorizing a description the rules and the learned
# model can't place (src/lib/classify-llm.ts). Unset = that step is skipped.
ANTHROPIC_API_KEY=
