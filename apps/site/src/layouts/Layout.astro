---
import "@meridian/ui/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Meridian — See every dollar. Own every decision.",
  description = "A precision-built personal finance engine. Track net worth, spending, and investments with the clarity of a professional trading desk.",
} = Astro.props;

// Absolute and self-referencing, so the vendor host that still serves this app
// consolidates onto the real domain instead of competing with it.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#08080a" />
    <script is:inline>
      // Set before first paint so reveal targets start hidden without flashing.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
      );
      const observe = () =>
        document
          .querySelectorAll(".reveal:not(.is-visible)")
          .forEach((el) => io.observe(el));
      observe();
      document.addEventListener("astro:after-swap", observe);
      // React (the /admin panel) mounts .reveal nodes after this script runs.
      // observe() is idempotent — it filters :not(.is-visible) and io.observe on
      // an already-watched node is a no-op — so a re-scan per mutation batch is
      // enough. ponytail: rescans the whole doc per batch (~200 nodes, sub-ms);
      // switch to entry.addedNodes if it ever shows up in a profile.
      new MutationObserver(observe).observe(document.body, { childList: true, subtree: true });
    </script>
    <script>
      import "../scripts/interactions.ts";
    </script>
  </body>
</html>
