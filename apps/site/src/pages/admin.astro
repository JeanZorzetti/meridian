---
import Layout from "../layouts/Layout.astro";
import BudgetApp from "../components/react/BudgetApp.tsx";
import { getMonthView } from "@meridian/db";

export const prerender = false;

// middleware guarantees a user here (redirects to /login otherwise)
const user = Astro.locals.user!;
const now = new Date();
const month = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
const initial = await getMonthView(user.id, month, now);
---

<Layout title="Meridian — Orçamento" description="Seu orçamento pessoal.">
  <main class="min-h-screen">
    <BudgetApp client:load initial={initial} username={user.username} />
  </main>
</Layout>
