---
import Layout from "../layouts/Layout.astro";
import { getSessionUser, SESSION_COOKIE } from "@meridian/db/auth";

export const prerender = false;

// already signed in → straight to the app
const current = await getSessionUser(Astro.cookies.get(SESSION_COOKIE)?.value);
if (current) return Astro.redirect("/admin");

const error = Astro.url.searchParams.get("error");
---

<Layout title="Meridian — Entrar" description="Acesso ao painel.">
  <main class="flex min-h-screen items-center justify-center px-6">
    <div class="w-full max-w-sm">
      <a href="/" class="inline-flex items-center gap-2.5" aria-label="Meridian home">
        <svg width="26" height="26" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="9.25" stroke="currentColor" stroke-width="1.5" class="text-foreground/70"></circle>
          <path d="M2 11h18" stroke="#3ecf8e" stroke-width="1.5"></path>
          <path d="M11 1.75v18.5" stroke="currentColor" stroke-width="1.5" class="text-foreground/25"></path>
        </svg>
        <span class="text-lg font-semibold tracking-[-0.02em]">Meridian</span>
      </a>

      <p class="eyebrow mt-10">Painel</p>
      <h1 class="mt-3 text-2xl font-semibold tracking-[-0.02em]">Entrar</h1>

      {error && (
        <p class="border-destructive/40 bg-destructive/10 text-destructive mt-6 rounded-md border px-3 py-2 text-sm">
          {error === "locked"
            ? "Muitas tentativas. Aguarde alguns minutos e tente de novo."
            : "Usuário ou senha inválidos."}
        </p>
      )}

      <form method="POST" action="/api/login" class="mt-6 flex flex-col gap-3">
        <label class="flex flex-col gap-1.5">
          <span class="text-muted-foreground text-xs">Usuário</span>
          <input
            name="username"
            autocomplete="username"
            required
            autofocus
            class="border-input bg-surface-1 focus-visible:ring-ring/50 h-10 rounded-md border px-3 text-sm outline-none focus-visible:ring-2"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-muted-foreground text-xs">Senha</span>
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            required
            class="border-input bg-surface-1 focus-visible:ring-ring/50 h-10 rounded-md border px-3 text-sm outline-none focus-visible:ring-2"
          />
        </label>
        <button
          type="submit"
          class="bg-primary text-primary-foreground hover:bg-primary/90 mt-2 inline-flex h-10 items-center justify-center rounded-md px-4 text-sm font-medium transition-colors"
        >
          Entrar
        </button>
      </form>
    </div>
  </main>
</Layout>
