---
const links = [
  { href: "#features", label: "Features" },
  { href: "#tour", label: "Product" },
  { href: "#security", label: "Security" },
  { href: "/pricing", label: "Pricing" },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300"
  data-scrolled="false"
  data-menu="closed"
>
  <nav class="wrap flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="Meridian home">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="9.25" stroke="currentColor" stroke-width="1.5" class="text-foreground/70"></circle>
        <path d="M2 11h18" stroke="#3ecf8e" stroke-width="1.5"></path>
        <path d="M11 1.75v18.5" stroke="currentColor" stroke-width="1.5" class="text-foreground/25"></path>
      </svg>
      <span class="text-[15px] font-semibold tracking-[-0.02em]">Meridian</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-muted-foreground hover:text-foreground text-sm transition-colors"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/admin"
        class="text-muted-foreground hover:text-foreground hidden px-3 py-2 text-sm transition-colors md:inline-flex"
        >Sign in</a
      >
      <a
        href="#cta"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center rounded-md px-3.5 py-2 text-sm font-medium transition-colors"
        >Get started</a
      >
      <button
        id="menu-toggle"
        type="button"
        class="text-foreground hover:bg-accent -mr-1.5 inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors md:hidden"
        aria-label="Open menu"
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <svg class="menu-open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg class="menu-close hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- mobile panel -->
  <div id="mobile-nav" class="mobile-panel md:hidden">
    <div class="overflow-hidden">
      <div class="wrap flex flex-col gap-1 pt-2 pb-5">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="text-muted-foreground hover:text-foreground hover:bg-accent -mx-2 rounded-md px-2 py-2.5 text-[15px] transition-colors"
              data-nav-link
            >
              {l.label}
            </a>
          ))
        }
        <a
          href="/admin"
          class="text-muted-foreground hover:text-foreground hover:bg-accent -mx-2 rounded-md px-2 py-2.5 text-[15px] transition-colors"
          data-nav-link
        >
          Sign in
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const nav = document.getElementById("site-nav");
    const toggle = document.getElementById("menu-toggle");
    if (!nav || !toggle) return;

    const onScroll = () => {
      nav.dataset.scrolled = String(window.scrollY > 8);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const setMenu = (open) => {
      nav.dataset.menu = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.querySelector(".menu-open").classList.toggle("hidden", open);
      toggle.querySelector(".menu-close").classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () =>
      setMenu(nav.dataset.menu !== "open"),
    );
    nav
      .querySelectorAll("[data-nav-link]")
      .forEach((a) => a.addEventListener("click", () => setMenu(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setMenu(false);
    });
    const mq = window.matchMedia("(min-width: 768px)");
    mq.addEventListener("change", (e) => e.matches && setMenu(false));
  })();
</script>

<style>
  #site-nav[data-scrolled="true"] {
    background: hsl(240 6% 4% / 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--hairline);
  }
  /* Open menu is a real overlay — near-opaque so links stay legible. */
  #site-nav[data-menu="open"] {
    background: hsl(240 6% 4% / 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--hairline);
  }
  /* grid-rows collapse: smooth height with no JS measurement */
  .mobile-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s var(--ease-swiss);
  }
  #site-nav[data-menu="open"] .mobile-panel {
    grid-template-rows: 1fr;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-panel {
      transition: none;
    }
  }
</style>
