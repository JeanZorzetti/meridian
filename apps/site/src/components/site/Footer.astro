---
const columns = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "#features" },
      { label: "Security", href: "#security" },
      { label: "Pricing", href: "/pricing" },
      { label: "Changelog", href: "#" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "#" },
      { label: "Careers", href: "#" },
      { label: "Blog", href: "#" },
      { label: "Contact", href: "#" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "#" },
      { label: "Terms", href: "#" },
      { label: "Security", href: "#security" },
      { label: "Status", href: "#" },
    ],
  },
];
---

<footer class="border-border border-t">
  <div class="wrap py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5" aria-label="Meridian home">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="9.25" stroke="currentColor" stroke-width="1.5" class="text-foreground/70"></circle>
            <path d="M2 11h18" stroke="#3ecf8e" stroke-width="1.5"></path>
            <path d="M11 1.75v18.5" stroke="currentColor" stroke-width="1.5" class="text-foreground/25"></path>
          </svg>
          <span class="text-[15px] font-semibold tracking-[-0.02em]">Meridian</span>
        </a>
        <p class="text-muted-foreground mt-4 max-w-xs text-sm leading-relaxed">
          See every dollar. Own every decision. A precision-built home for your
          whole financial picture.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="eyebrow mb-4">{col.title}</p>
            <ul class="space-y-3">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="border-border mt-14 flex flex-col items-center justify-between gap-4 border-t pt-8 sm:flex-row">
      <p class="text-muted-foreground font-mono text-xs">
        © 2026 Meridian Finance · Built by Jean Zorzetti
      </p>
      <p class="text-muted-foreground font-mono text-xs">
        Made with precision in Goiânia, BR
      </p>
    </div>
  </div>
</footer>
